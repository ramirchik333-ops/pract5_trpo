<Page x:Class="prakt5.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt5"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal">
                <Label Content="ID" Width="100"/>
                <TextBox Margin="5" Width="100" Text="{Binding Id}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Название" Width="100"/>
                <TextBox Margin="5" Width="200" Text="{Binding Name}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Категория" Width="100"/>
                <TextBox Margin="5" Width="200" Text="{Binding Category}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Порций" Width="100"/>
                <TextBox Margin="5" Width="100" Text="{Binding Portions}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Калорийность" Width="150"/>
                <TextBox Margin="5" Text="{Binding RecipeCalories, Mode=OneWay, StringFormat={}{0:f2}}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="5">
            <Label Content="Ингридиенты"/>
            <StackPanel Orientation="Horizontal">
                <Button Margin="5" Padding="5" Click="Addingridient_Click">Добавить ингридиент</Button>
                <Button Margin="5" Padding="5" Click="Deleteingridient_Click">Удалить ингридиент</Button>
            </StackPanel>
            <ListView ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelecteIngredient}" Height="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name}" Margin="2" Padding="2"/>
                            <TextBox Grid.Column="1" Text="{Binding WeightGrams}" Margin="2" Padding="2"/>
                            <TextBox Grid.Column="2" Text="{Binding CaloriesPer100g}" Margin="2" Padding="2"/>
                            <TextBox Grid.Column="3" Text="{Binding IngredientCalories, Mode=OneWay}" Margin="2" Padding="2"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" Click="SaveButton_Click" Margin="5" Padding="10,5"/>
            <Button Content="Назад" Click="BackButton_Click" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Page>
