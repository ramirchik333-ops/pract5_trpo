<Page x:Class="prakt5.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt5"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Margin="5" Padding="5" Click="addButton_Click">Добавить</Button>
            <Button Margin="5" Padding="5" Click="deleteButton_Click">Удалить</Button>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" MouseDoubleClick="EditRecipe_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ID: " />
                            <TextBlock Text="{Binding Id}"/>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Text="Название: " />
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Text="Категория: " />
                            <TextBlock Text="{Binding Category}"/>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Text="Порций: " />
                            <TextBlock Text="{Binding Portions}"/>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Text="Калорийность: " />
                            <TextBlock Text="{Binding RecipeCalories, Mode=OneWay, StringFormat={}{0:f2}}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" Background="AntiqueWhite">
            <Label Content="Всего рецептов: "/>
            <Label Content="{Binding Recipes.Count}"/>
        </StackPanel>
    </Grid>
</Page>
